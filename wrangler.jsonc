// Cloudflare deploy: AvaCam's files, plus /api/captions (worker.js, speech recognition on Workers AI).
// Deploy with:  npx wrangler deploy
{
  "name": "avacam",
  "compatibility_date": "2026-11-18",
  "main": "worker.js",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" }
}
